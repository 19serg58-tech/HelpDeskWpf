<Window x:Class="HelpDeskWpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="300" Width="250"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Resources>
        <!-- Стили для кнопки и полей ввода -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вход в Help Desk" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>

            <TextBlock Text="Логин:" FontSize="14"/>
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Пароль:" FontSize="14"/>
            <!-- В PasswordBox нельзя напрямую сделать Binding из-за безопасности, 
                 мы передадим пароль при клике на кнопку -->
            <PasswordBox Name="txtPassword"/>

            <!-- Текст ошибки (красный, виден только если есть текст) -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" HorizontalAlignment="Center" Margin="0,5,0,0"/>

            <!-- Команда привязывается, но пароль передаем через CommandParameter -->
            <Button Content="Войти" Click="BtnLogin_Click" IsDefault="True" Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Window>